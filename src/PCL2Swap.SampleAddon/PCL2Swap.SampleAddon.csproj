<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>PCL2Swap.SampleAddon</AssemblyName>
    <RootNamespace>PCL2Swap.SampleAddon</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Company>OxygenAILab</Company>
    <Product>PCL2Swap sample addon</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PCL2Swap.Api\PCL2Swap.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sample builds a real WPF page (live counters), so it needs the desktop references. -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
</Project>
