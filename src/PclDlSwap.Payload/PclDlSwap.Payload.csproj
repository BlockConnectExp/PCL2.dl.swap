<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!--
      AnyCPU on purpose: PCL ships as an ILONLY/AnyCPU executable, so it runs as a 64-bit process on
      every modern Windows install while the disk-patch loader stays x86. The same payload assembly
      must therefore load into both bitnesses.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Platforms>AnyCPU;x86</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PclDlSwap.Payload</AssemblyName>
    <RootNamespace>PclDlSwap.Payload</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <Company>OxygenAILab</Company>
    <Product>PCL2 DLL-Swap payload</Product>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gee.External.Capstone" Version="2.3.0" />
    <PackageReference Include="MonoMod.Utils" Version="22.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PCL2Swap.Api\PCL2Swap.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\pcl2swap-org-icon.png" />
    <!-- The ExLoader shape ships the payload alone, so the token manifest travels with it. -->
    <EmbeddedResource Include="..\..\data\offset-manifest.json" LogicalName="PclDlSwap.Payload.data.offset-manifest.json" />
    <!-- The PclSurface dumps travel with the payload so addons can query the host surface. -->
    <EmbeddedResource Include="..\..\data\pcl-surface-2.99.0.json" LogicalName="PclDlSwap.Payload.data.pcl-surface-2.99.0.json" />
    <EmbeddedResource Include="..\..\data\pcl-surface-2.99.0.1.json" LogicalName="PclDlSwap.Payload.data.pcl-surface-2.99.0.1.json" />
    <!-- The addon repository index travels with the payload so the page can show a bundled entry
         even when the network is down. -->
    <EmbeddedResource Include="..\..\data\addons-index.json" LogicalName="PclDlSwap.Payload.data.addons-index.json" />
    <!-- Official public key for signing the addon index (private half stays out of the repo). -->
    <EmbeddedResource Include="..\..\data\index-key.pub.xml" LogicalName="PclDlSwap.Payload.data.index-key.pub.xml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Swap settings pages are real WPF content; the addon manager unpacks .swapaddon zips. -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
