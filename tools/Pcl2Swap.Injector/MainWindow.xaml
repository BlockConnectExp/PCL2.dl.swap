<Window
    x:Class="Pcl2Swap.Injector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pcl2Swap.Injector.Models"
    Title="PCL2 Swap Injector">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Padding="20,14,20,10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="38" Height="38" CornerRadius="9"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="PCL2 Swap" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="注入器正在启动…"
                               FontSize="12" Opacity="0.65" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="RefreshButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="OnRefreshClick" ToolTipService.ToolTip="重新扫描进程并拉取 Release 列表">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Padding="20,0,20,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Targets -->
            <Grid ColumnSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                    <TextBlock Text="目标" FontWeight="SemiBold" />
                    <TextBlock Text="运行中的 PCL2 或手动选择" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <ListView x:Name="TargetList" SelectionMode="Single"
                                  SelectionChanged="OnTargetSelectionChanged"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TargetInfo">
                                    <Grid Padding="10,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind SupportGlyph}" FontSize="15"
                                                  VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind ProcessLabel}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind VersionLabel}" Opacity="0.75"
                                                       FontSize="12" />
                                            <TextBlock Text="{x:Bind SupportLabel}" Opacity="0.65"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="TargetEmptyHint"
                                   Text="没有检测到运行中的 PCL2。&#x0a;你可以先在 PCL2 里打开游戏主界面，&#x0a;或点击下方按钮手动选择可执行文件。"
                                   TextWrapping="Wrap" Opacity="0.55" FontSize="13"
                                   Margin="18,18,18,0" VerticalAlignment="Top"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
                    <Button x:Name="PickFileButton" HorizontalAlignment="Stretch"
                            Click="OnPickFileClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="选择 PCL2 可执行文件并启动注入…" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SelectedTargetDetail" FontSize="12" Opacity="0.65"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Grid>

            <!-- Releases -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                    <TextBlock Text="注入包" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReleaseSourceLabel" Text="来自 GitHub Releases"
                               FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="8" Height="168"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <ListView x:Name="ReleaseList" SelectionMode="Single"
                                  SelectionChanged="OnReleaseSelectionChanged"
                                  Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReleaseInfo">
                                    <Grid Padding="10,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind BadgeLabel}" FontSize="11"
                                                           Opacity="0.6" />
                                                <TextBlock Text="{x:Bind PublishedLabel}" FontSize="11"
                                                           Opacity="0.6" />
                                                <TextBlock Text="{x:Bind SizeLabel}" FontSize="11"
                                                           Opacity="0.6" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ReleaseEmptyHint"
                                   Text="正在读取 Release 列表…"
                                   Opacity="0.55" FontSize="13"
                                   Margin="18,18,18,0" VerticalAlignment="Top"
                                   TextWrapping="Wrap" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" CornerRadius="8" Margin="0,10,0,0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" Padding="16,12,16,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NotePanel" Spacing="2" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="20,8,20,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"
                          VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       Text="准备就绪。" TextWrapping="Wrap" />
            <Button x:Name="InjectButton" Grid.Column="2" Content="注入"
                    Style="{ThemeResource AccentButtonStyle}" MinWidth="132"
                    IsEnabled="False" Click="OnInjectClick" />
        </Grid>

        <InfoBar x:Name="ResultBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                 VerticalAlignment="Bottom" Margin="20,0,20,8"
                 Severity="Success" />
    </Grid>
</Window>
