<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pcl2Swap.Injector</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Pcl2Swap.Injector</AssemblyName>
    <ApplicationTitle>PCL2 Swap Injector</ApplicationTitle>
    <Version>26.1.0.0</Version>
    <FileVersion>26.1.0.0</FileVersion>
    <InformationalVersion>v26.1-Alpha 9</InformationalVersion>
  </PropertyGroup>

  <!--
    Reference the smallest WinUI surface instead of the Microsoft.WindowsAppSDK meta package:
    the meta package drags in the AI/ML/Search/Widgets sub-packages, which add onnxruntime,
    DirectML and the semantic-index stack (roughly 140 MB) that this injector never touches.
    WinUI already pulls Base + Foundation + InteractiveExperiences; Runtime supplies the
    self-contained deployment targets.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\offset-manifest.json"
                      LogicalName="Pcl2Swap.Injector.data.offset-manifest.json" />
  </ItemGroup>

</Project>
